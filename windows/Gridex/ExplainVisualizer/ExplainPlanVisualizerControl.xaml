<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Gridex.ExplainPlanVisualizerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <!-- ── Empty state: no plan loaded yet ─────────────────────── -->
        <Grid x:Name="EmptyState"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520" Spacing="12">
                <FontIcon Glyph="&#xE9D9;" FontSize="36" Opacity="0.55"/>
                <TextBlock Text="Visualize execution plan"
                           FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock TextWrapping="Wrap"
                           Opacity="0.75" FontSize="13"
                           TextAlignment="Center"
                           Text="Run your query with EXPLAIN ANALYZE and we'll render the plan tree, hot paths, and tuning recommendations."/>
                <Button x:Name="EmptyRunBtn" Click="OnRunClicked"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="13"/>
                        <TextBlock Text="Run with Explain Analyze"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="EmptyHint" Opacity="0.5" FontSize="11"
                           HorizontalAlignment="Center"
                           Text="Postgres only — MySQL coming soon."/>
            </StackPanel>
        </Grid>

        <!-- ── Loading state ───────────────────────────────────────── -->
        <Grid x:Name="LoadingState" Visibility="Collapsed"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <controls:ProgressRing IsActive="True" Width="36" Height="36"/>
                <TextBlock x:Name="LoadingText"
                           Text="Running EXPLAIN ANALYZE..."
                           Opacity="0.75" FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ── Error state ─────────────────────────────────────────── -->
        <Grid x:Name="ErrorState" Visibility="Collapsed"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520" Spacing="10">
                <FontIcon Glyph="&#xE783;" FontSize="28"
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                <TextBlock Text="Couldn't run EXPLAIN ANALYZE"
                           FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ErrorText"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Opacity="0.75" FontSize="12"/>
                <Button Click="OnRunClicked" HorizontalAlignment="Center"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                        <TextBlock Text="Try again"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── Loaded state ────────────────────────────────────────── -->
        <Grid x:Name="LoadedState" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Padding="20,16,20,28" Spacing="18">

                    <!-- Run bar -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Click="OnRunClicked" Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                <TextBlock Text="Re-run"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnCopyPlanClicked" Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                <TextBlock Text="Copy plan"/>
                            </StackPanel>
                        </Button>
                        <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Margin="4,0"/>
                        <TextBlock x:Name="MetaText" VerticalAlignment="Center"
                                   FontSize="11" Opacity="0.6"
                                   Text=""/>
                    </StackPanel>

                    <!-- InfoBar (warning callout) -->
                    <controls:InfoBar x:Name="WarnInfoBar"
                                      Severity="Warning"
                                      IsClosable="True"
                                      IsOpen="False"
                                      Title=""
                                      Message=""/>

                    <!-- Summary metrics -->
                    <Grid x:Name="MetricsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="CardTotalTime" Grid.Column="0" Margin="0,0,8,0"/>
                        <ContentControl x:Name="CardRows"      Grid.Column="1" Margin="4,0"/>
                        <ContentControl x:Name="CardBuffers"   Grid.Column="2" Margin="4,0"/>
                        <ContentControl x:Name="CardAccuracy"  Grid.Column="3" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Plan section header -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Execution plan"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="PlanCountText" Grid.Column="1"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Opacity="0.55"
                                   Text=""/>
                        <ToggleButton x:Name="HotOnlyToggle" Grid.Column="2"
                                      Padding="8,4" FontSize="11"
                                      Click="OnHotOnlyToggled">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE71C;" FontSize="11"/>
                                <TextBlock Text="Show only hot"/>
                            </StackPanel>
                        </ToggleButton>
                    </Grid>

                    <!-- Plan tree + Flyout (two-column layout) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6,8">
                            <StackPanel x:Name="PlanTreeContainer" Spacing="2"/>
                        </Border>

                        <Border Grid.Column="1" x:Name="FlyoutBorder"
                                Width="340" Margin="12,0,0,0"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel x:Name="FlyoutContainer" Padding="14,12" Spacing="10"/>
                        </Border>
                    </Grid>

                    <!-- Timing waterfall -->
                    <TextBlock Text="Timing waterfall"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="0,12,0,0"/>
                    <TextBlock Opacity="0.55" FontSize="12"
                               Text="Actual time per node, in execution order."/>
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel x:Name="WaterfallContainer" Spacing="6"/>
                    </Border>

                    <!-- Recommendations -->
                    <TextBlock Text="Recommendations"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="0,12,0,0"/>
                    <TextBlock Opacity="0.55" FontSize="12"
                               Text="Suggestions are derived from the plan above. Click Preview to copy the SQL into a new tab."/>
                    <StackPanel x:Name="RecsContainer" Spacing="8"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
